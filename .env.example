# ======================================================================
# Roblox Crew Manager — environment variables
# Copy to .env.local for local dev, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# NONE of these are exposed to the browser (no NEXT_PUBLIC_ prefix).
# ======================================================================

# --- Supabase (Project Settings → API) ---------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key — server only, NEVER share or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Storage bucket for original screenshots (created by the migration)
SUPABASE_STORAGE_BUCKET=snapshots

# --- Manager accounts (exactly two managers) ----------------------------
# Each manager logs in with their own name + password so the audit log
# knows who did what. Use long random passwords.
MANAGER_1_NAME=Manager1
MANAGER_1_PASSWORD=change-me-to-a-long-random-password-1
MANAGER_2_NAME=Manager2
MANAGER_2_PASSWORD=change-me-to-a-long-random-password-2

# Secret used to sign session cookies (min 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-random-string-of-at-least-32-characters

# --- OCR / AI Vision (Vercel AI Gateway) --------------------------------
# On Vercel, AI Gateway authenticates automatically via OIDC once enabled.
# For local dev (or outside Vercel) set an AI Gateway API key:
# https://vercel.com/dashboard → AI Gateway → API Keys
AI_GATEWAY_API_KEY=
# Any vision-capable model available on AI Gateway, "provider/model"
OCR_MODEL=anthropic/claude-sonnet-5.5
